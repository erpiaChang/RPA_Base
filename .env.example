# .env 의 꼴 (10-02). 이것을 .env 로 복사해 값을 채운다 — .env 는 git 에 올리지 않는다.
# RPA 프로그램이 쓰는 계정·비밀번호·서버 값은 여기가 아니라 config/settings.local.json 이다 (docs/SETTINGS.md).

# 웹 대시보드 — tools/build_web 이 web/ 의 자리표시를 이 값으로 바꿔 build/web 에 만든다 (deploy_web.bat)
SUPABASE_URL=https://<프로젝트 id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 빌드에 굽는 비밀번호를 감싸는 씨앗 (utils/secret.py). 아무 긴 무작위 글자 — 예: python -c "import secrets;print(secrets.token_hex(32))"
BAKED_SEED=
